---
import { render } from 'astro:content';
import { pageContent } from '../lib/content';
import { getTranslations, type Lang } from '../i18n';
import Icon from './Icon.astro';
import Stripes from './Stripes.astro';
interface Props { lang: Lang; page: string; feed?: string; }
const { lang, page, feed } = Astro.props;
const entry = await pageContent(lang, page);
if (!entry) throw new Error(`Missing page content: ${lang}/${page}`);
const { Content } = await render(entry);
const t = getTranslations(lang);
---
<section class="page-intro">
  <h1>{entry.data.title}{feed && <a class="rss-link" href={feed} data-astro-reload title={page === 'columns' ? t.columnRss : t.rss} aria-label={page === 'columns' ? t.columnRss : t.rss}><Icon name="rss" /></a>}</h1>
  <div class="intro-copy prose"><Content /></div>
</section>
<Stripes class="intro-divider" />
