---
import { getTranslations, type Lang } from '../i18n';
import { articles, articleUrl, discussionKey } from '../lib/content';
import { commentService } from '../lib/comments';
const { lang } = Astro.props as { lang: Lang };
const t = getTranslations(lang);
const localArticles = [...await articles(lang), ...await articles(lang, 'seriesPosts')];
const discussions = Object.fromEntries(localArticles.map(post => [discussionKey(post), { url: articleUrl(post), title: post.data.title }]));
---
<section class="latest-comments" data-lang={lang} data-discussions={JSON.stringify(discussions)} data-canonical-origin={Astro.site?.origin} data-host={commentService.host} data-site={commentService.site} data-loading={t.loading} data-empty={t.noComments} data-error={t.commentsFailed} data-unconfigured={t.commentsUnconfigured} data-reply={t.reply} data-anonymous={t.anonymous} data-expand={t.expand} data-collapse={t.collapse} data-expand-comments={t.expandComments} data-collapse-comments={t.collapseComments}>
  <h2>{t.recentComments}</h2>
  <p class="comments-status muted" role="status">{t.loading}</p>
  <div id="recent-comment-list" class="latest-comments-list" aria-live="polite"></div>
  <button class="comments-retry text-button" type="button" hidden>{t.retry}</button>
  <button class="comments-more text-button" type="button" aria-controls="recent-comment-list" aria-expanded="false" hidden>{t.expand} ﹀</button>
</section>
<script>
  interface Comment {
    id: number;
    rid: number;
    nick: string;
    date: string;
    content_marked: string;
    page_key: string;
    email_encrypted?: string;
  }
  let controller: AbortController | undefined;
  function initComments() {
    controller?.abort();
    controller = new AbortController();
    const pageSignal = controller.signal;
    const root = document.querySelector<HTMLElement>('.latest-comments');
    if (root) {
      const list = root.querySelector<HTMLElement>('.latest-comments-list')!;
      const status = root.querySelector<HTMLElement>('.comments-status')!;
      const more = root.querySelector<HTMLButtonElement>('.comments-more')!;
      const retry = root.querySelector<HTMLButtonElement>('.comments-retry')!;
      const { host, site, lang = 'zh' } = root.dataset;
      const discussions = new Map<string, { url: string; title: string }>(Object.entries(JSON.parse(root.dataset.discussions || '{}')));
      let avatarConfig: Promise<{ base: URL; params: string } | null> | undefined;
      let comments: Comment[] = [];
      let visible = 0;
      let expansions = 0;
      const initialCount = 3;
      const shouldCollapse = () => expansions >= 2 || visible >= comments.length;
      function updateButton() {
        const collapse = shouldCollapse();
        more.hidden = comments.length <= initialCount;
        more.textContent = collapse ? root!.dataset.collapse! : `${root!.dataset.expand} ﹀`;
        more.setAttribute('aria-label', (collapse ? root!.dataset.collapseComments : root!.dataset.expandComments)!);
        more.setAttribute('aria-expanded', String(expansions > 0));
      }
      const discussionUrl = (key: string, id: number) => {
        const article = discussions.get(key);
        const path = article?.url ?? (
          /^\/(posts|series)\//.test(key) ? (root.dataset.canonicalOrigin ?? '') + '/' + lang + key : '/' + lang + '/'
        );
        return path + '#atk-comment-' + id;
      };
      async function loadAvatar(avatar: HTMLElement, hash?: string) {
        if (!host || !hash || !/^(?:[a-f\d]{32}|[a-f\d]{64})$/i.test(hash)) return;
        avatarConfig ??= (async () => {
          const signal = AbortSignal.any([pageSignal, AbortSignal.timeout(5000)]);
          const response = await fetch(`${host}/api/v2/conf`, { credentials: 'omit', signal });
          if (!response.ok) return null;
          const { frontend_conf } = await response.json() as {
            frontend_conf?: { gravatar?: { mirror?: string; params?: string } };
          };
          const { mirror, params } = frontend_conf?.gravatar ?? {};
          const base = new URL(mirror || 'https://www.gravatar.com/avatar/', host);
          if (!['https:', 'http:'].includes(base.protocol)) return null;
          return { base, params: params ?? 'sha256=1&d=mp&s=240' };
        })().catch(() => null);
        const config = await avatarConfig;
        if (!config || pageSignal.aborted || !avatar.isConnected) return;

        const url = new URL(config.base);
        url.pathname = url.pathname.replace(/\/+$/, '') + '/' + hash;
        url.search = config.params;
        const image = new Image();
        image.alt = '';
        image.decoding = 'async';
        image.referrerPolicy = 'no-referrer';
        image.addEventListener('load', () => {
          if (avatar.isConnected) avatar.replaceChildren(image);
        }, { once: true, signal: pageSignal });
        image.src = url.href;
      }
      function appendBatch(count: number) {
        const end = Math.min(visible + count, comments.length);
        const names = new Map(comments.map(comment => [comment.id, comment.nick]));
        for (const item of comments.slice(visible, end)) {
          const card = document.createElement('article'); card.className = 'comment-card';
          const avatar = document.createElement('span'); avatar.className = 'comment-avatar';
          const name = item.nick || root!.dataset.anonymous!;
          avatar.textContent = name.slice(0, 1).toUpperCase();
          void loadAvatar(avatar, item.email_encrypted);
          const body = document.createElement('div'); body.className = 'comment-body';
          const meta = document.createElement('div'); meta.className = 'comment-byline';
          const author = document.createElement('span'); author.textContent = name; meta.append(author);
          if (item.rid && names.get(item.rid)) { const reply = document.createElement('span'); reply.textContent = `${root!.dataset.reply} ${names.get(item.rid)}`; meta.append(reply); }
          const date = document.createElement('time');
          if (/^\d{4}-\d{2}-\d{2}[ T]/.test(item.date)) {
            date.dateTime = item.date.replace(' ', 'T');
            date.textContent = item.date.slice(0, 10);
            meta.append(date);
          }
          const text = document.createElement('p');
          const parsed = document.createElement('template');
          parsed.innerHTML = item.content_marked || '';
          text.textContent = parsed.content.textContent?.trim() || (lang === 'zh' ? '[图片]' : '[Image]');
          const link = document.createElement('a');
          link.className = 'comment-source';
          link.href = discussionUrl(item.page_key, item.id);
          link.textContent = discussions.get(item.page_key)?.title ?? (lang === 'zh' ? '查看讨论' : 'View discussion');
          body.append(meta, text, link); card.append(avatar, body); list.append(card);
        }
        visible = end;
        updateButton();
      }
      function toggleComments() {
        if (shouldCollapse()) {
          [...list.children].slice(initialCount).forEach(card => card.remove());
          visible = initialCount;
          expansions = 0;
          updateButton();
        } else {
          expansions += 1;
          appendBatch(4);
        }
      }
      async function load() {
        retry.hidden = true; more.hidden = true; status.hidden = false;
        status.textContent = root!.dataset.loading!;
        if (!host || !site) { status.textContent = root!.dataset.unconfigured!; return; }
        try {
          const response = await fetch(`${host}/api/v2/stats/latest_comments?site_name=${encodeURIComponent(site)}&limit=100`, { credentials: 'omit', signal: AbortSignal.any([pageSignal, AbortSignal.timeout(12000)]) });
          if (!response.ok) throw new Error('Comment service unavailable');
          const { data } = await response.json() as { data: Comment[] };
          if (!Array.isArray(data)) throw new Error('Invalid recent comments');
          comments = data;
          list.replaceChildren(); visible = 0; expansions = 0;
          if (!comments.length) { status.textContent = root!.dataset.empty!; return; }
          status.hidden = true; appendBatch(initialCount);
        } catch { if (pageSignal.aborted) return; status.textContent = root!.dataset.error!; retry.hidden = false; }
      }
      more.addEventListener('click', toggleComments, { signal: pageSignal }); retry.addEventListener('click', load, { signal: pageSignal }); load();
    }
  }
  document.addEventListener('astro:page-load', initComments);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
