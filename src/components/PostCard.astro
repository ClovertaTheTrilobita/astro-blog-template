---
import { getTranslations, type Lang } from '../i18n';
import { articleUrl, articleTransition, articlePreviewParagraphs, type Article } from '../lib/content';
import PostMeta from './PostMeta.astro';
import PostDiscount from './PostDiscount.astro';
interface Props { post: Article; lang: Lang; compact?: boolean; }
const { post, lang, compact = false } = Astro.props;
const t = getTranslations(lang);
const preview = await articlePreviewParagraphs(post);
---
<article class:list={['post-card', { 'post-card-compact': compact }]}>
  {compact && post.data.image && <a class="post-image-link" href={articleUrl(post)} tabindex="-1" aria-hidden="true"><img class="post-thumbnail" src={post.data.image.url} alt="" width="120" height="120" loading="lazy" transition:name={articleTransition(post, 'image')} /></a>}
  <h3><a href={articleUrl(post)} transition:name={articleTransition(post, 'title')}>{post.data.title}</a><PostDiscount post={post} lang={lang} />{post.data.sample && <span class="sample-label">{t.sample}</span>}</h3>
  <div class="post-card-body">
    {!compact && post.data.image && <a class="post-image-link" href={articleUrl(post)} tabindex="-1" aria-hidden="true"><img class="post-thumbnail" src={post.data.image.url} alt="" width="120" height="120" loading="lazy" transition:name={articleTransition(post, 'image')} /></a>}
    {compact ? <div class="post-description">{preview.map((paragraph, index) => <p>{paragraph}{index === preview.length - 1 && <a class="read-post" href={articleUrl(post)}>{t.viewPost}</a>}</p>)}</div> : <p class="post-description">{preview[0]}</p>}
    {!compact && <div class="tags flex flex-wrap gap-x-4 gap-y-1">{post.data.tags.map(tag => <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>}
    <PostMeta post={post} />
  </div>
</article>
