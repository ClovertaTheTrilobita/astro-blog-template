---
import { getTranslations, type Lang } from '../i18n';
import { articleUrl, articleTransition, type Article } from '../lib/content';
import PostMeta from './PostMeta.astro';
import { render } from 'astro:content';
interface Props { post: Article; lang: Lang; compact?: boolean; }
const { post, lang, compact = false } = Astro.props;
const t = getTranslations(lang);
const preview = compact ? (await render(post)).remarkPluginFrontmatter.bodyExcerpt as string : post.data.description;
---
<article class:list={['post-card', { 'post-card-compact': compact }]}>
  {compact && post.data.image && <a class="post-image-link" href={articleUrl(post)} tabindex="-1" aria-hidden="true"><img class="post-thumbnail" src={post.data.image.url} alt="" width="120" height="120" loading="lazy" transition:name={articleTransition(post, 'image')} /></a>}
  <h3><a href={articleUrl(post)} transition:name={articleTransition(post, 'title')}>{post.data.title}</a>{post.data.sample && <span class="sample-label">{t.sample}</span>}</h3>
  <div class="post-card-body">
    {!compact && post.data.image && <a class="post-image-link" href={articleUrl(post)} tabindex="-1" aria-hidden="true"><img class="post-thumbnail" src={post.data.image.url} alt="" width="120" height="120" loading="lazy" transition:name={articleTransition(post, 'image')} /></a>}
    <p class="post-description">{preview}{compact && <a class="read-post" href={articleUrl(post)}>{t.viewPost}</a>}</p>
    {!compact && <div class="tags flex flex-wrap gap-x-4 gap-y-1">{post.data.tags.map(tag => <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>}
    <PostMeta post={post} />
  </div>
</article>
