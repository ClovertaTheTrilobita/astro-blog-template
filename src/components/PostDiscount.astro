---
import type { Article } from '../lib/content';
import type { Lang } from '../i18n';
interface Props { post: Article; lang: Lang; }
const { post, lang } = Astro.props;
const discount = post.collection === 'seriesPosts' ? post.data.discount : undefined;
const label = discount === undefined ? '' : lang === 'zh'
  ? `(${discount}折!)`
  : `(${Number((100 - discount).toFixed(2))}% off!)`;
---
{label && <span class="discount-label">{label}</span>}

<style>
  .discount-label {
    display: inline;
    color: var(--accent);
    font-size: inherit;
    font-weight: 300;
    margin-block: 0;
    margin-inline-start: .35em;
    white-space: nowrap;
  }
</style>
