---
interface Props { name: 'rss' | 'moon' | 'sun' | 'comment' | 'github' | 'mail'; class?: string; }
const { name, class: className = '' } = Astro.props;
---
{name === 'sun' ? <svg class:list={['icon', className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1m0-15.6-2.1 2.1M6.3 17.7l-2.1 2.1"/></svg> : <span class:list={['icon', `icon-${name}`, className]} aria-hidden="true" />}
