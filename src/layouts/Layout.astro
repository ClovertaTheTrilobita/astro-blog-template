---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { getTranslations, getLangFromUrl } from "../i18n";
import Icon from "../components/Icon.astro";
import Stripes from "../components/Stripes.astro";
import BuildHashBlocks from "../components/BuildHashBlocks.astro";
import ImagePreview from "../components/ImagePreview.astro";
import { ClientRouter, fade } from "astro:transitions";
interface Props {
  title?: string;
  description?: string;
  active?: string;
  alternatePath?: string;
  image?: string;
}
const {
  title,
  description = "Half Price! 半价便当同好会！",
  active = "home",
  alternatePath,
  image = "/images/avatar.jpg",
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const otherLang = lang === "zh" ? "en" : "zh";
const alternate =
  alternatePath ??
  Astro.url.pathname.replace(/^\/(zh|en)(?=\/|$)/, `/${otherLang}`);
const links = Object.entries(t.nav);
const canonical = new URL(Astro.url.pathname, Astro.site);
const displayFontUrl = `https://fonts.googleapis.com/css2?family=ZCOOL+QingKe+HuangYou&display=swap&text=${encodeURIComponent(t.backgroundTitle + t.backgroundText)}`;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&display=swap"
    />
    <link rel="stylesheet" href={displayFontUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · ${t.siteTitle}` : t.siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang={otherLang === "zh" ? "zh-CN" : "en"}
      href={new URL(alternate, Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.rss}
      href={lang === "zh" ? "/rss.xml" : `/${lang}/rss.xml`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.columnRss}
      href={`/${lang}/series/rss.xml`}
    />
    <meta property="og:title" content={title ?? t.siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline data-astro-rerun>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        document.documentElement.classList.toggle(
          "dark",
          theme
            ? theme === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches,
        );
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content"
      >{lang === "zh" ? "跳至正文" : "Skip to content"}</a
    >
    <div
      class="background-word"
      aria-hidden="true"
      transition:name="site-background"
      transition:animate="none"
    >
      {t.backgroundText}
    </div>
    <div class="site-shell">
      <header
        class="masthead flex items-start justify-between gap-4"
        transition:name="site-header"
        transition:animate="none"
      >
        <div class="brand">
          <span class="brand-watermark" aria-hidden="true"
            >{t.backgroundTitle}</span
          >
          <a class="brand-title" href={`/${lang}/`}>{t.siteTitle}</a>
          <Stripes large />
        </div>
        <div class="header-controls flex items-center gap-2">
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            aria-label={t.theme}
            title={t.theme}
            aria-pressed="false"
            ><Icon name="moon" class="moon-icon" /><Icon
              name="sun"
              class="sun-icon"
            /></button
          >
          <a
            class="language-switch"
            href={alternate}
            lang={otherLang}
            aria-label={otherLang === "en" ? "Switch to English" : "切换为中文"}
            >{t.language}</a
          >
        </div>
      </header>
      <div class="workspace">
        <aside
          class="sidebar"
          transition:name="site-sidebar"
          transition:animate="none"
        >
          <a
            class="avatar-link"
            href={`https://cloverta.top/`}
            aria-label={t.nav.about}
            ><img
              class="avatar"
              src="/images/avatar.jpg"
              width="110"
              height="110"
              alt="Cloverta"
            /></a
          >
          <nav aria-label={t.menu}>
            {
              links.map(([key, label]) => (
                <a
                  class:list={["nav-link", { current: active === key }]}
                  href={key === "home" ? `/${lang}/` : `/${lang}/${key}/`}
                  aria-current={active === key ? "page" : undefined}
                >
                  <span>{label}</span>
                </a>
              ))
            }
          </nav>
        </aside>
        <main
          id="main-content"
          class="min-w-0"
          transition:name="page-content"
          transition:animate={fade({ duration: "0.24s" })}
        >
          <slot />
        </main>
      </div>
      <footer
        class="site-footer"
        transition:name="site-footer"
        transition:animate="none"
      >
        <Stripes large class="footer-stripes" />
        <div class="social-links flex justify-center items-center gap-6">
          <a
            href="https://github.com/ClovertaTheTrilobita/"
            aria-label="GitHub"
            target="_blank"
            rel="me noopener noreferrer"><Icon name="github" /></a
          >
          <a
            href="mailto:cloverta@petalmail.com"
            aria-label={lang === "zh" ? "发送邮件" : "Email"}
            ><Icon name="mail" /></a
          >
        </div>
        <p>
          © {new Date().getUTCFullYear()} ClovertaTheTrilobita · <a
            href="https://github.com/ClovertaTheTrilobita/astro-blog-template"
            target="_blank"
            rel="noopener noreferrer">Source code</a
          >
          {t.license}
          {t.footer}
        </p>
        <BuildHashBlocks />
      </footer>
    </div>
    <ImagePreview lang={lang} />
    <script>
      let titleShadowController: AbortController | undefined;
      let clearTitleShadow: (() => void) | undefined;
      function initTitleShadow() {
        titleShadowController?.abort();
        clearTitleShadow?.();
        const title = document.querySelector<HTMLElement>(".brand-title");
        if (!title) return;
        titleShadowController = new AbortController();
        const { signal } = titleShadowController;
        clearTitleShadow = () => title.removeAttribute("data-light-source");
        const updateShadow = (event: PointerEvent) => {
          if (event.pointerType !== "mouse") return;
          const bounds = title.getBoundingClientRect();
          const dx = bounds.left + bounds.width / 2 - event.clientX;
          const dy = bounds.top + bounds.height / 2 - event.clientY;
          const distance = Math.hypot(dx, dy);
          const radius = Math.hypot(bounds.width / 2, bounds.height / 2);
          const proximity = 1 - Math.min(distance / Math.max(radius, 1), 1);
          // Keep the shadow opposite the light source without exceeding 14px.
          const scale = Math.min(distance * .12, 14) / (distance || 1);
          title.style.setProperty("--title-shadow-x", `${dx * scale}px`);
          title.style.setProperty("--title-shadow-y", `${dy * scale}px`);
          title.style.setProperty("--title-shadow-blur", `${10 - proximity * 4}px`);
          title.style.setProperty("--title-shadow-opacity", String(.12 + proximity * .3));
          title.setAttribute("data-light-source", "");
        };
        title.addEventListener("pointerenter", updateShadow, { signal });
        title.addEventListener("pointermove", updateShadow, { signal });
        title.addEventListener("pointerleave", clearTitleShadow, { signal });
        title.addEventListener("pointercancel", clearTitleShadow, { signal });
        window.addEventListener("blur", clearTitleShadow, { signal });
      }
      document.addEventListener("astro:page-load", initTitleShadow);
      document.addEventListener("astro:before-swap", () => {
        titleShadowController?.abort();
        clearTitleShadow?.();
      });
      const updateButton = () =>
        document
          .querySelector("#theme-toggle")
          ?.setAttribute(
            "aria-pressed",
            String(document.documentElement.classList.contains("dark")),
          );
      const applyTheme = () => {
        let stored;
        try {
          stored = localStorage.getItem("theme");
        } catch {}
        document.documentElement.classList.toggle(
          "dark",
          stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches,
        );
        updateButton();
      };
      document.addEventListener("astro:after-swap", applyTheme);
      document.addEventListener("astro:page-load", () => {
        updateButton();
        document
          .querySelector("#theme-toggle")
          ?.addEventListener("click", () => {
            const dark = document.documentElement.classList.toggle("dark");
            try {
              localStorage.setItem("theme", dark ? "dark" : "light");
            } catch {}
            updateButton();
          });
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener(
        "change",
        (event) => {
          let stored;
          try {
            stored = localStorage.getItem("theme");
          } catch {}
          if (!stored) {
            document.documentElement.classList.toggle("dark", event.matches);
            updateButton();
          }
        },
      );
    </script>
  </body>
</html>
