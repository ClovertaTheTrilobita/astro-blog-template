---
import Layout from './Layout.astro';
import Stripes from '../components/Stripes.astro';
import Remark42Embed from '../components/Remark42Embed.astro';
import { articles, articleSlug, articleUrl, articleTransition, articleSummary, formatDate, type Article } from '../lib/content';
import { getTranslations, type Lang } from '../i18n';
import type { MarkdownHeading } from 'astro';
interface Props { post: Article; headings: MarkdownHeading[]; }
const { post, headings } = Astro.props;
const lang = post.id.split('/')[0] as Lang;
const t = getTranslations(lang);
const isColumn = post.collection === 'columnPosts';
const summary = await articleSummary(post);
const siblings = (await articles(lang, post.collection)).filter(item => !isColumn || item.id.split('/')[2] === post.id.split('/')[2]);
const index = siblings.findIndex(item => item.id === post.id);
const previous = siblings[index - 1]; const next = siblings[index + 1];
const otherLang = lang === 'zh' ? 'en' : 'zh';
const translated = (await articles(otherLang, post.collection)).find(item => articleSlug(item) === articleSlug(post));
const alternate = translated ? articleUrl(translated) : `/${otherLang}/${isColumn ? 'columns' : 'archive'}/`;
---
<Layout active={isColumn ? 'columns' : ''} title={post.data.title} description={summary} image={post.data.image?.url} alternatePath={alternate}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class:list={['post-article', { 'column-article': isColumn }]}>
    <header class="article-header">
      {isColumn && post.data.image && <img class="article-cover" src={post.data.image.url} alt={post.data.image.alt} width="126" height="126" transition:name={articleTransition(post, 'image')} />}
      <h1 transition:name={articleTransition(post, 'title')}>{post.data.title}</h1>
      {!isColumn && post.data.image && <img class="article-cover" src={post.data.image.url} alt={post.data.image.alt} width="126" height="126" transition:name={articleTransition(post, 'image')} />}
      {!isColumn && <p class="article-description">{summary}</p>}
      <p class="article-byline">{t.author} {post.data.author}<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.sample && <span class="sample-label">{t.sample}</span>}</p>
      {!isColumn && <div class="tags flex flex-wrap gap-x-4 gap-y-1">{post.data.tags.map(tag => <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>}
    </header>
    <Stripes class="article-divider" />
    {headings.length > 0 && <aside class="article-toc"><details open><summary>{t.contents}</summary><nav aria-label={t.contents}>{headings.map(heading => <a href={`#${heading.slug}`} class:list={{ 'toc-sub': heading.depth > 2 }}>{heading.text}</a>)}</nav></details></aside>}
    <div class="prose article-content"><slot /></div>
    <nav class="post-pagination" aria-label={lang === 'zh' ? '相邻文章' : 'Adjacent posts'}>
      <div>{previous && <><span>{t.previous}</span><a href={articleUrl(previous)}>{previous.data.title}</a></>}</div>
      <div>{next && <><span>{t.next}</span><a href={articleUrl(next)}>{next.data.title}</a></>}</div>
    </nav>
    <section id="comments" class="comments-section">
      <h2>{t.comments}</h2><p>{t.commentPrompt}</p><p>{t.subscribe}</p>
      <Remark42Embed slug={isColumn ? `columns/${articleSlug(post)}` : articleSlug(post)} pagePath={isColumn ? `/columns/${articleSlug(post)}/` : undefined} />
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: summary, datePublished: post.data.pubDate.toISOString(), author: { '@type': 'Person', name: post.data.author }, mainEntityOfPage: new URL(articleUrl(post), Astro.site).href }).replaceAll('<', '\\u003c')} />
</Layout>
<script>
  let controller: AbortController | undefined;
  function initArticle() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const article = document.querySelector<HTMLElement>('.article-content');
    const progress = document.querySelector<HTMLElement>('.reading-progress');
    if (!article || !progress) return;
    const updateProgress = () => {
      const start = article.getBoundingClientRect().top + scrollY;
      const distance = Math.max(article.offsetHeight - innerHeight, 1);
      progress.style.transform = `scaleX(${Math.min(1, Math.max(0, (scrollY - start) / distance))})`;
    };
    addEventListener('scroll', updateProgress, { passive: true, signal });
    addEventListener('resize', updateProgress, { signal });
    updateProgress();
    article.querySelectorAll<HTMLElement>('pre').forEach(pre => {
      const button = document.createElement('button'); button.type = 'button'; button.className = 'copy-code';
      const zh = document.documentElement.lang.startsWith('zh'); button.textContent = zh ? '复制' : 'Copy';
      button.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || ''); button.textContent = zh ? '已复制' : 'Copied'; }
        catch { button.textContent = zh ? '复制失败' : 'Copy failed'; }
        setTimeout(() => { if (!signal.aborted) button.textContent = zh ? '复制' : 'Copy'; }, 1800);
      }, { signal });
      pre.append(button);
    });
  }
  document.addEventListener('astro:page-load', initArticle);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
