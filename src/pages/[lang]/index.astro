---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PostCard from '../../components/PostCard.astro';
import PostMeta from '../../components/PostMeta.astro';
import PostDiscount from '../../components/PostDiscount.astro';
import LatestComments from '../../components/LatestComments.astro';
import { articles, columns, columnId, columnCover, articleUrl, columnTransition } from '../../lib/content';
import { languagePaths, getTranslations } from '../../i18n';
export const getStaticPaths = languagePaths;
const { lang } = Astro.params as { lang: 'zh' | 'en' };
const t = getTranslations(lang);
const posts = (await articles(lang)).slice(0, 4);
const entries = await articles(lang, 'seriesPosts');
const latestColumns = columns(lang).map(column => ({ ...column, posts: entries.filter(post => columnId(post) === column.id) })).filter(column => column.posts.length).sort((a,b) => b.posts[0].data.pubDate.valueOf() - a.posts[0].data.pubDate.valueOf());
---
<Layout active="home">
  <PageIntro lang={lang} page="home" feed={lang === 'zh' ? '/rss.xml' : `/${lang}/rss.xml`} />
  <section class="home-section">
    <h2>{t.latest}</h2>
    {posts.map(post => <PostCard post={post} lang={lang} />)}
    {!posts.length && <p class="muted">{t.noPosts}</p>}
    <a class="more-link" href={`/${lang}/archive/`}>{t.more}</a>
  </section>
  <section class="home-section column-updates">
    <h2>{t.columnUpdates}</h2>
    {latestColumns.map(column => <article class="post-card column-card">
      <h3><a href={`/${lang}/series/${column.id}/`} transition:name={columnTransition(lang, column.id, 'title')}>{column.title}</a></h3>
      <div class="post-card-body">
        <a class="post-image-link" href={`/${lang}/series/${column.id}/`} tabindex="-1" aria-hidden="true"><img class="post-thumbnail" src={columnCover(column, column.posts)} width="120" height="120" alt="" loading="lazy" transition:name={columnTransition(lang, column.id, 'image')} /></a>
        <ul class="column-preview">{column.posts.slice(0, 4).map((post, index) => <li><a href={articleUrl(post)}>{post.data.title}</a><PostDiscount post={post} lang={lang} />{index === 0 && <span class="latest-label">{t.latestLabel}</span>}</li>)}<li><a href={`/${lang}/series/${column.id}/`}>{lang === 'zh' ? '更多…' : 'More…'}</a></li></ul>
        <PostMeta post={column.posts[0]} />
      </div>
    </article>)}
    <a class="more-link" href={`/${lang}/series/`}>{t.more}</a>
  </section>
  <LatestComments lang={lang} />
</Layout>
<script>
  let controller: AbortController | undefined;
  function initPostCardLayout() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const cards = [...document.querySelectorAll<HTMLElement>('.home-section > .post-card:not(.column-card):has(.post-image-link)')];
    if (!cards.length) return;
    const desktop = matchMedia('(min-width: 701px)');
    let frame = 0;
    function updateLayout() {
      for (const card of cards) {
        if (!desktop.matches) {
          card.classList.remove('post-card-image-top');
          continue;
        }
        const title = card.querySelector<HTMLHeadingElement>('h3')!;
        const image = card.querySelector<HTMLElement>('.post-image-link')!;
        const imageStyle = getComputedStyle(image);
        const coverRightWidth = card.clientWidth - parseFloat(imageStyle.marginRight);
        const availableWidth = coverRightWidth - image.offsetWidth - parseFloat(imageStyle.marginLeft);
        // Measure a single line independently of the card's current layout.
        const measure = title.cloneNode(true) as HTMLHeadingElement;
        measure.setAttribute('aria-hidden', 'true');
        measure.style.cssText = 'position: fixed; visibility: hidden; white-space: nowrap; width: max-content; max-width: none;';
        card.append(measure);
        const fits = measure.getBoundingClientRect().width <= availableWidth;
        measure.remove();
        card.style.setProperty('--post-title-width', `${fits ? availableWidth : coverRightWidth}px`);
        card.classList.toggle('post-card-image-top', fits);
      }
    }
    function queueUpdate() {
      if (frame || signal.aborted) return;
      frame = requestAnimationFrame(() => { frame = 0; updateLayout(); });
    }
    const observer = new ResizeObserver(queueUpdate);
    cards.forEach(card => observer.observe(card));
    document.fonts.addEventListener('loadingdone', queueUpdate, { signal });
    document.fonts.ready.then(queueUpdate);
    signal.addEventListener('abort', () => { observer.disconnect(); cancelAnimationFrame(frame); }, { once: true });
    updateLayout();
  }
  document.addEventListener('astro:page-load', initPostCardLayout);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
