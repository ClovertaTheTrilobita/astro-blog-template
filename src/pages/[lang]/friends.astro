---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getCollection } from 'astro:content';
import { languagePaths, getTranslations } from '../../i18n';
export const getStaticPaths = languagePaths;
const { lang } = Astro.params as { lang: 'zh' | 'en' };
const t = getTranslations(lang);
const friends = await getCollection('friends');
---
<Layout active="friends" title={t.nav.friends}>
  <PageIntro lang={lang} page="friends" />
  <div class="friend-list flex flex-wrap items-start gap-6">
    {friends.map(friend => <a class="friend-card" href={friend.data.url} target="_blank" rel="noopener noreferrer"><div><h2>{friend.data.name}</h2><p>{friend.data.description}</p></div><img src={friend.data.avatar} alt="" width="58" height="58" loading="lazy" /></a>)}
  </div>
</Layout>
