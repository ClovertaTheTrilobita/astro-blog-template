---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import Stripes from '../../../components/Stripes.astro';
import { getCollection } from 'astro:content';
import { byDate } from '../../../lib/content';
import { languages, getTranslations, type Lang } from '../../../i18n';
export async function getStaticPaths() {
 const posts = await getCollection('posts', post => !post.data.draft);
 return languages.flatMap(lang => [...new Set(posts.filter(post => post.id.startsWith(`${lang}/`)).flatMap(post => post.data.tags))].map(tag => ({ params: { lang, tag }, props: { posts: posts.filter(post => post.id.startsWith(`${lang}/`) && post.data.tags.includes(tag)).sort(byDate), translated: posts.some(post => !post.id.startsWith(`${lang}/`) && post.data.tags.includes(tag)) } })));
}
const { lang, tag } = Astro.params as { lang: Lang; tag: string };
const { posts, translated } = Astro.props;
const t = getTranslations(lang);
---
<Layout active="tags" title={`#${tag}`} alternatePath={translated ? undefined : `/${lang === 'zh' ? 'en' : 'zh'}/tags/`}>
  <h1 class="page-heading">#{tag}</h1>
  <p class="muted">{posts.length} {t.tagCount} · <a href={`/${lang}/tags/`}>{t.allTags}</a></p>
  <Stripes class="intro-divider" />
  {posts.map(post => <PostCard post={post} lang={lang} />)}
</Layout>
