---
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import { articles } from '../../../lib/content';
import { languagePaths, getTranslations } from '../../../i18n';
export const getStaticPaths = languagePaths;
const { lang } = Astro.params as { lang: 'zh' | 'en' };
const t = getTranslations(lang);
const posts = await articles(lang);
const counts = new Map<string, number>();
for (const post of posts) for (const tag of new Set(post.data.tags)) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], lang));
---
<Layout active="tags" title={t.nav.tags}>
  <PageIntro lang={lang} page="tags" />
  <div class="tag-cloud flex flex-wrap items-baseline gap-x-7 gap-y-6">{tags.map(([tag, count]) => <a href={`/${lang}/tags/${encodeURIComponent(tag)}/`}><span>#{tag}</span><sup>{count}</sup></a>)}</div>
</Layout>
