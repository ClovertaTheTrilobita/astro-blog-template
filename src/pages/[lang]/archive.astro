---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PostMeta from '../../components/PostMeta.astro';
import { articles, articleUrl, articleTransition } from '../../lib/content';
import { languagePaths, getTranslations } from '../../i18n';
export const getStaticPaths = languagePaths;
const { lang } = Astro.params as { lang: 'zh' | 'en' };
const t = getTranslations(lang);
const posts = await articles(lang);
const years = [...new Set(posts.map(post => post.data.pubDate.getUTCFullYear()))];
---
<Layout active="archive" title={t.nav.archive}>
  <PageIntro lang={lang} page="archive" />
  <div class="archive-list">
    {years.map(year => <section class="archive-year"><h2>{year}</h2>{posts.filter(post => post.data.pubDate.getUTCFullYear() === year).map(post => <article class="archive-entry"><h3><a href={articleUrl(post)} transition:name={articleTransition(post, 'title')}>{post.data.title}</a></h3><PostMeta post={post} /></article>)}</section>)}
    {!posts.length && <p>{t.noPosts}</p>}
  </div>
</Layout>
