---
import Layout from '../../layouts/Layout.astro';
import Stripes from '../../components/Stripes.astro';
import { pageContent } from '../../lib/content';
import { render } from 'astro:content';
import { languagePaths, getTranslations } from '../../i18n';
export const getStaticPaths = languagePaths;
const { lang } = Astro.params as { lang: 'zh' | 'en' };
const t = getTranslations(lang);
const page = await pageContent(lang, 'about');
if (!page) throw new Error('Missing about page');
const { Content } = await render(page);
---
<Layout active="about" title={t.nav.about}>
  <article class="about-page">
    <h1 class="page-heading">{page.data.title}</h1>
    <Stripes class="intro-divider" />
    <div class="prose about-copy"><Content /></div>
  </article>
</Layout>

<style>
  .page-heading { font-size: 28px; }
  .about-copy { font-size: 17px; }
  .about-copy :global(h2) { font-size: 28px; }
  .about-copy :global(h3) { font-size: 23px; }
  .about-copy :global(h4) { font-size: 20px; }

  @media (max-width: 700px) {
    .page-heading { font-size: 25px; }
    .about-copy { font-size: 16px; }
    .about-copy :global(h2) { font-size: 24px; }
    .about-copy :global(h3) { font-size: 21px; }
  }
</style>
