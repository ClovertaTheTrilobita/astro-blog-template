---
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import PostCard from '../../../components/PostCard.astro';
import { articles, columns, columnId, columnTransition } from '../../../lib/content';
import { languagePaths, getTranslations } from '../../../i18n';
export const getStaticPaths = languagePaths;
const { lang } = Astro.params as { lang: 'zh' | 'en' };
const t = getTranslations(lang);
const posts = await articles(lang, 'columnPosts');
---
<Layout active="columns" title={t.nav.columns}>
  <PageIntro lang={lang} page="columns" feed={`/${lang}/columns/rss.xml`} />
  <h2 class="columns-latest">{t.latestUpdates}</h2>
  {columns(lang).map(column => <section class="column-group"><h2 class="column-heading"><a href={`/${lang}/columns/${column.id}/`} transition:name={columnTransition(lang, column.id, 'title')}>{column.title}</a></h2>{posts.filter(post => columnId(post) === column.id).slice(0, 4).map(post => <PostCard post={post} lang={lang} compact />)}<a class="more-link" href={`/${lang}/columns/${column.id}/`}>{t.more}</a></section>)}
</Layout>
